\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Mean test accuracy versus labeled training-set size $n$ for TF-IDF+LR and three weakened transformer variants (BERT-tiny, DistilBERT-trunc8, DistilBERT-trunc16), on TweetEval and Rotten Tomatoes (3 seeds per cell). DistilBERT-trunc16 crosses TF-IDF on both domains; DistilBERT-trunc8 crosses only on Rotten Tomatoes; BERT-tiny never crosses on either domain.}}{6}{figure.2}\protected@file@percent }
\newlabel{fig:accuracy_curves}{{2}{6}{Mean test accuracy versus labeled training-set size $n$ for TF-IDF+LR and three weakened transformer variants (BERT-tiny, DistilBERT-trunc8, DistilBERT-trunc16), on TweetEval and Rotten Tomatoes (3 seeds per cell). DistilBERT-trunc16 crosses TF-IDF on both domains; DistilBERT-trunc8 crosses only on Rotten Tomatoes; BERT-tiny never crosses on either domain}{figure.2}{}}
